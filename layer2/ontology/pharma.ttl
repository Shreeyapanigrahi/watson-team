# Watson pharma ontology (hand-written). Schema only: no instances live here.
# Instances are written by populate_graph.py (reference data, from the data catalog) and by
# enrichment_pipeline.py (documents, chunks, entities, sentiment, lineage) into pharma_kg.ttl.
#
# Domains are left off properties that are used on more than one class (mentionsBrand is used on
# chunks AND documents, derivedFrom on chunks AND lineage records). An rdfs:domain would make the
# OWL RL reasoner infer a wrong type (a document typed as a chunk). SHACL shapes constrain usage instead.

@prefix Watson: <http://watson.local/pharma#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .   # used by the DOID / MeSH alignments written by populate_graph.py, not in this file
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://watson.local/pharma> a owl:Ontology ;
    rdfs:label "Watson pharma ontology" ;
    rdfs:comment "Semantic foundation for governed pharma market-research documents. Every term is grounded in the data catalog or declared as a Watson extension (see Watson:groundingStatus, written by populate_graph.py)." .

# ------------------------------------------------------------------ document classes (4 levels deep)
Watson:Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "Any governed document." .

Watson:MarketResearchDocument a owl:Class ;
    rdfs:label "Market research document" ;
    rdfs:comment "A primary market research (PMR) study. Carries study_type, expiry_date, lifecycleState and sensitivityLevel." ;
    rdfs:subClassOf Watson:Document .

Watson:HCPSentimentStudy a owl:Class ;
    rdfs:label "HCP sentiment study" ;
    rdfs:comment "A study whose purpose is to measure how healthcare professionals feel about a brand." ;
    rdfs:subClassOf Watson:MarketResearchDocument .

Watson:HCPPerceptionSurvey a owl:Class ;
    rdfs:label "HCP perception survey" ;
    rdfs:subClassOf Watson:HCPSentimentStudy .

Watson:CompetitiveLandscapeReport a owl:Class ;
    rdfs:label "Competitive landscape report" ;
    rdfs:subClassOf Watson:MarketResearchDocument .

Watson:IndicationDeepDive a owl:Class ;
    rdfs:label "Indication deep dive" ;
    rdfs:subClassOf Watson:MarketResearchDocument .

Watson:MarketAccessInsight a owl:Class ;
    rdfs:label "Market access insight" ;
    rdfs:subClassOf Watson:MarketResearchDocument .

Watson:KOLInterviewSummary a owl:Class ;
    rdfs:label "KOL interview summary" ;
    rdfs:subClassOf Watson:MarketResearchDocument .

Watson:TherapyAreaLandscape a owl:Class ;
    rdfs:label "Therapy area landscape" ;
    rdfs:subClassOf Watson:MarketResearchDocument .

Watson:DocumentChunk a owl:Class ;
    rdfs:label "Document chunk" ;
    rdfs:comment "A sub-unit of a document. A first-class class with its own URI (not a blank node) so the vector index, access control and answer citations can all point at it." .

# ------------------------------------------------------------------ domain entities
Watson:Drug a owl:Class ;
    rdfs:label "Drug" ;
    rdfs:comment "An active substance, distinct from the commercial brand that contains it." ;
    owl:equivalentClass obo:CHEBI_23888 .

Watson:DrugClass a owl:Class ;
    rdfs:label "Drug class" ;
    rdfs:comment "A pharmacological class such as PD-1 inhibitor." .

Watson:Brand a owl:Class ;
    rdfs:label "Brand" ;
    rdfs:comment "A commercial product containing one drug." .

Watson:Indication a owl:Class ;
    rdfs:label "Indication" ;
    rdfs:comment "A disease or condition a brand is used for. Each indication is one shared named individual, not duplicated per brand." .

Watson:HCP a owl:Class ;
    rdfs:label "HCP" ;
    rdfs:comment "A physician, specialist or prescriber who is a research subject. No individuals are created: the catalog tags name and NPI columns as PII." .

Watson:TherapeuticArea a owl:Class ;
    rdfs:label "Therapeutic area" .

Watson:Geography a owl:Class ;
    rdfs:label "Geography" ;
    rdfs:comment "A country or a region, with its payer system type." .

Watson:SentimentAssertion a owl:Class ;
    rdfs:label "Sentiment assertion" ;
    rdfs:comment "One HCP sentiment score for a Brand, in a Geography, about an Indication, at a date. A first-class node so GROUP BY and AVG work in SPARQL." .

Watson:CompetitiveLandscape a owl:Class ;
    rdfs:label "Competitive landscape" ;
    rdfs:comment "A structured comparison of the brands competing within one therapeutic area, as stated by one document." .

Watson:KnowledgeSpace a owl:Class ;
    rdfs:label "Knowledge space" ;
    rdfs:comment "A curated, named collection of documents under a topic." .

Watson:LineageRecord a owl:Class ;
    rdfs:label "Lineage record" ;
    rdfs:comment "One enrichment run over one document: who approved it, which model, when, how much was written." .

Watson:Reviewer a owl:Class ;
    rdfs:label "Reviewer" ;
    rdfs:comment "A human who approved a document or owns a knowledge space." .

Watson:RetrievalEvent a owl:Class ;
    rdfs:label "Retrieval event" ;
    rdfs:comment "One chunk returned to one user by the search endpoint. Written to telemetry_store.json, not to the graph: the governance audit (Q10) loads it into a temporary graph and joins it to the chunks." .

Watson:ProvisionalEntity a owl:Class ;
    rdfs:label "Provisional entity" ;
    rdfs:comment "A candidate entity found in a document that is not in the catalog. Waits for a human decision." .

Watson:CatalogAsset a owl:Class ;
    rdfs:label "Catalog asset" ;
    rdfs:comment "A table or column of the data catalog, represented in the graph so grounding can be validated." .

# ------------------------------------------------------------------ object properties (12 required + extras)
Watson:containsDrug a owl:ObjectProperty ;
    rdfs:label "contains drug" ;
    owl:inverseOf Watson:isDrugOf ;
    rdfs:domain Watson:Brand ;
    rdfs:range Watson:Drug .

Watson:isDrugOf a owl:ObjectProperty ;
    rdfs:label "is drug of" ;
    rdfs:domain Watson:Drug ;
    rdfs:range Watson:Brand .

Watson:targetedIndication a owl:ObjectProperty ;
    rdfs:label "targeted indication" ;
    rdfs:domain Watson:Brand ;
    rdfs:range Watson:Indication .

Watson:inTherapeuticArea a owl:ObjectProperty ;
    rdfs:label "in therapeutic area" ;
    rdfs:range Watson:TherapeuticArea .

Watson:coversGeography a owl:ObjectProperty ;
    rdfs:label "covers geography" ;
    rdfs:range Watson:Geography .

Watson:mentionsBrand a owl:ObjectProperty ;
    rdfs:label "mentions brand" ;
    rdfs:range Watson:Brand .

Watson:mentionsIndication a owl:ObjectProperty ;
    rdfs:label "mentions indication" ;
    rdfs:range Watson:Indication .

Watson:mentionsDrug a owl:ObjectProperty ;
    rdfs:label "mentions drug" ;
    rdfs:range Watson:Drug .

Watson:mentionsDrugClass a owl:ObjectProperty ;
    rdfs:label "mentions drug class" ;
    rdfs:range Watson:DrugClass .

Watson:mentionsProvisional a owl:ObjectProperty ;
    rdfs:label "mentions provisional entity" ;
    rdfs:range Watson:ProvisionalEntity .

Watson:isChunkOf a owl:ObjectProperty ;
    rdfs:label "is chunk of" ;
    owl:inverseOf Watson:hasChunk ;
    rdfs:domain Watson:DocumentChunk ;
    rdfs:range Watson:MarketResearchDocument .

Watson:hasChunk a owl:ObjectProperty ;
    rdfs:label "has chunk" ;
    rdfs:domain Watson:MarketResearchDocument ;
    rdfs:range Watson:DocumentChunk .

Watson:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from" ;
    rdfs:comment "Chunk to lineage record, and lineage record to document. A SPARQL path over it traces any chunk back to its source document, the run that made it and the reviewer who approved it." .

Watson:processedDocument a owl:ObjectProperty ;
    rdfs:label "processed document" ;
    rdfs:domain Watson:LineageRecord ;
    rdfs:range Watson:MarketResearchDocument ;
    rdfs:subPropertyOf Watson:derivedFrom .

Watson:reviewedBy a owl:ObjectProperty ;
    rdfs:label "reviewed by" ;
    rdfs:domain Watson:LineageRecord ;
    rdfs:range Watson:Reviewer .

Watson:containsDocument a owl:ObjectProperty ;
    rdfs:label "contains document" ;
    owl:inverseOf Watson:isInSpace ;
    rdfs:domain Watson:KnowledgeSpace ;
    rdfs:range Watson:MarketResearchDocument .

Watson:isInSpace a owl:ObjectProperty ;
    rdfs:label "is in space" ;
    rdfs:domain Watson:MarketResearchDocument ;
    rdfs:range Watson:KnowledgeSpace .

Watson:hasSentiment a owl:ObjectProperty ;
    rdfs:label "has sentiment" ;
    rdfs:domain Watson:Brand ;
    rdfs:range Watson:SentimentAssertion .

Watson:forBrand a owl:ObjectProperty ;
    rdfs:label "for brand" ;
    rdfs:domain Watson:SentimentAssertion ;
    rdfs:range Watson:Brand .

Watson:forIndication a owl:ObjectProperty ;
    rdfs:label "for indication" ;
    rdfs:domain Watson:SentimentAssertion ;
    rdfs:range Watson:Indication .

Watson:forGeography a owl:ObjectProperty ;
    rdfs:label "for geography" ;
    rdfs:domain Watson:SentimentAssertion ;
    rdfs:range Watson:Geography .

Watson:competesWithin a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "competes within" ;
    rdfs:comment "Two brands compared in the same competitive landscape document." ;
    rdfs:domain Watson:Brand ;
    rdfs:range Watson:Brand .

Watson:coMentionedWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "co-mentioned with" ;
    rdfs:comment "Two brands named in the same chunk." ;
    rdfs:domain Watson:Brand ;
    rdfs:range Watson:Brand .

Watson:hasDrugClass a owl:ObjectProperty ;
    rdfs:label "has drug class" ;
    rdfs:domain Watson:Drug ;
    rdfs:range Watson:DrugClass .

Watson:partOfRegion a owl:ObjectProperty ;
    rdfs:label "part of region" ;
    rdfs:domain Watson:Geography ;
    rdfs:range Watson:Geography .

Watson:includesBrand a owl:ObjectProperty ;
    rdfs:label "includes brand" ;
    rdfs:domain Watson:CompetitiveLandscape ;
    rdfs:range Watson:Brand .

Watson:describedBy a owl:ObjectProperty ;
    rdfs:label "described by" ;
    rdfs:domain Watson:CompetitiveLandscape ;
    rdfs:range Watson:MarketResearchDocument .

Watson:retrievedChunk a owl:ObjectProperty ;
    rdfs:label "retrieved chunk" ;
    rdfs:domain Watson:RetrievalEvent ;
    rdfs:range Watson:DocumentChunk .

Watson:spaceOwner a owl:ObjectProperty ;
    rdfs:label "space owner" ;
    rdfs:domain Watson:KnowledgeSpace ;
    rdfs:range Watson:Reviewer .

Watson:spaceTherapeuticArea a owl:ObjectProperty ;
    rdfs:label "space therapeutic area" ;
    rdfs:domain Watson:KnowledgeSpace ;
    rdfs:range Watson:TherapeuticArea .

Watson:groundedIn a owl:ObjectProperty ;
    rdfs:label "grounded in" ;
    rdfs:comment "Points from an ontology term or an entity to the catalog table or column it is grounded in. Deliberately not owl:equivalentClass: a catalog table 'brand' holds brand master records, it is not the concept of a brand, and an equivalence would make a reasoner merge them." ;
    rdfs:range Watson:CatalogAsset ;
    rdfs:subPropertyOf rdfs:seeAlso .

# The one transitive property: a sub-indication belongs to every ancestor indication.
Watson:subIndicationOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "sub-indication of" ;
    rdfs:comment "Transitive on purpose: if EGFR-mutant NSCLC is a sub-indication of NSCLC, and NSCLC of lung cancer, then EGFR-mutant NSCLC is a sub-indication of lung cancer. Without it, a question about lung cancer misses documents that only name a subtype." ;
    rdfs:domain Watson:Indication ;
    rdfs:range Watson:Indication .

# ------------------------------------------------------------------ datatype properties (8 required + extras)
# Naming: new terms are camelCase. The snake_case ones (quality_score, freshness_date, expiry_date, ingest_timestamp, study_type,
# chunk_index) keep their original names because the code, SPARQL queries and SHACL shapes refer to them; do not rename them casually.
Watson:sensitivityLevel a owl:DatatypeProperty ;
    rdfs:label "sensitivity level" ;
    rdfs:range xsd:string .

Watson:allowedTA a owl:DatatypeProperty ;
    rdfs:label "allowed therapeutic areas" ;
    rdfs:comment "Absent means all areas." ;
    rdfs:range xsd:string .

Watson:allowedGeo a owl:DatatypeProperty ;
    rdfs:label "allowed regions" ;
    rdfs:comment "Absent means all regions." ;
    rdfs:range xsd:string .

Watson:quality_score a owl:DatatypeProperty ;
    rdfs:label "quality score" ;
    rdfs:range xsd:double .

Watson:freshness_date a owl:DatatypeProperty ;
    rdfs:label "freshness date" ;
    rdfs:comment "The report date the freshness part of the quality score is measured from." ;
    rdfs:range xsd:date .

Watson:expiry_date a owl:DatatypeProperty ;
    rdfs:label "expiry date" ;
    rdfs:domain Watson:MarketResearchDocument ;
    rdfs:range xsd:date .

Watson:ingest_timestamp a owl:DatatypeProperty ;
    rdfs:label "ingest timestamp" ;
    rdfs:domain Watson:MarketResearchDocument ;
    rdfs:range xsd:dateTime .

Watson:lifecycleState a owl:DatatypeProperty ;
    rdfs:label "lifecycle state" ;
    rdfs:comment "A datatype property, so FILTER (?s = 'ACTIVE') is enough and no extra join is needed. See design_decisions.md for the trade-off against a named state individual." ;
    rdfs:domain Watson:MarketResearchDocument ;
    rdfs:range xsd:string .

Watson:study_type a owl:DatatypeProperty ;
    rdfs:label "study type" ;
    rdfs:domain Watson:MarketResearchDocument ;
    rdfs:range xsd:string .

Watson:documentTitle a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:domain Watson:MarketResearchDocument ;
    rdfs:range xsd:string .

Watson:taxonomyVersion a owl:DatatypeProperty ;
    rdfs:label "taxonomy version" ;
    rdfs:comment "Version of the taxonomy a classified triple was checked against." ;
    rdfs:range xsd:integer .

Watson:catalogVersion a owl:DatatypeProperty ;
    rdfs:label "catalog version" ;
    rdfs:range xsd:string .

Watson:sentimentScore a owl:DatatypeProperty ;
    rdfs:label "sentiment score" ;
    rdfs:domain Watson:SentimentAssertion ;
    rdfs:range xsd:double .

Watson:assertionDate a owl:DatatypeProperty ;
    rdfs:label "assertion date" ;
    rdfs:domain Watson:SentimentAssertion ;
    rdfs:range xsd:date .

# No chunk text property on purpose: the text stays in Layer 1's staging store and is read only after the ABAC filter.
Watson:chunk_index a owl:DatatypeProperty ;
    rdfs:label "chunk index" ;
    rdfs:domain Watson:DocumentChunk ;
    rdfs:range xsd:integer .

Watson:faissId a owl:DatatypeProperty ;
    rdfs:label "vector index id" ;
    rdfs:domain Watson:DocumentChunk ;
    rdfs:range xsd:integer .

Watson:chunksProduced a owl:DatatypeProperty ;
    rdfs:label "chunks produced" ;
    rdfs:domain Watson:LineageRecord ;
    rdfs:range xsd:integer .

Watson:triplesWritten a owl:DatatypeProperty ;
    rdfs:label "triples written" ;
    rdfs:domain Watson:LineageRecord ;
    rdfs:range xsd:integer .

Watson:processingTimestamp a owl:DatatypeProperty ;
    rdfs:label "processing timestamp" ;
    rdfs:domain Watson:LineageRecord ;
    rdfs:range xsd:dateTime .

Watson:enrichmentModel a owl:DatatypeProperty ;
    rdfs:label "enrichment model" ;
    rdfs:domain Watson:LineageRecord ;
    rdfs:range xsd:string .

Watson:requestedBy a owl:DatatypeProperty ;
    rdfs:label "requested by (user id)" ;
    rdfs:domain Watson:RetrievalEvent ;
    rdfs:range xsd:string .

Watson:userRole a owl:DatatypeProperty ;
    rdfs:label "role of the requesting user" ;
    rdfs:domain Watson:RetrievalEvent ;
    rdfs:range xsd:string .

Watson:eventTime a owl:DatatypeProperty ;
    rdfs:label "event time" ;
    rdfs:domain Watson:RetrievalEvent ;
    rdfs:range xsd:dateTime .

Watson:spaceName a owl:DatatypeProperty ;
    rdfs:label "space name" ;
    rdfs:domain Watson:KnowledgeSpace ;
    rdfs:range xsd:string .

Watson:created a owl:DatatypeProperty ;
    rdfs:label "created" ;
    rdfs:domain Watson:KnowledgeSpace ;
    rdfs:range xsd:dateTime .

Watson:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string .

Watson:mechanismOfAction a owl:DatatypeProperty ;
    rdfs:label "mechanism of action" ;
    rdfs:domain Watson:Drug ;
    rdfs:range xsd:string .

Watson:atcCode a owl:DatatypeProperty ;
    rdfs:label "ATC code" ;
    rdfs:domain Watson:Drug ;
    rdfs:range xsd:string .

Watson:molecularWeight a owl:DatatypeProperty ;
    rdfs:label "molecular weight" ;
    rdfs:comment "Defined for completeness. Our fictional drugs have no molecular weight, so none is written." ;
    rdfs:domain Watson:Drug ;
    rdfs:range xsd:double .

Watson:company a owl:DatatypeProperty ;
    rdfs:label "global brand owner" ;
    rdfs:domain Watson:Brand ;
    rdfs:range xsd:string .

Watson:geographyKind a owl:DatatypeProperty ;
    rdfs:label "country or region" ;
    rdfs:domain Watson:Geography ;
    rdfs:range xsd:string .

Watson:payerType a owl:DatatypeProperty ;
    rdfs:label "payer system type" ;
    rdfs:domain Watson:Geography ;
    rdfs:range xsd:string .

Watson:isoCode a owl:DatatypeProperty ;
    rdfs:label "ISO alpha-2 code" ;
    rdfs:domain Watson:Geography ;
    rdfs:range xsd:string .

Watson:isGrouping a owl:DatatypeProperty ;
    rdfs:label "is grouping node" ;
    rdfs:comment "True for an indication added only to group subtypes (lung cancer, breast cancer, heart failure)." ;
    rdfs:domain Watson:Indication ;
    rdfs:range xsd:boolean .

Watson:confidence a owl:DatatypeProperty ;
    rdfs:label "extraction confidence" ;
    rdfs:range xsd:double .

Watson:fqn a owl:DatatypeProperty ;
    rdfs:label "catalog full name" ;
    rdfs:domain Watson:CatalogAsset ;
    rdfs:range xsd:string .

Watson:assetOrigin a owl:DatatypeProperty ;
    rdfs:label "upstream or extension" ;
    rdfs:domain Watson:CatalogAsset ;
    rdfs:range xsd:string .

Watson:groundingStatus a owl:DatatypeProperty ;
    rdfs:label "grounding status" ;
    rdfs:comment "grounded, partial or extension. Written onto each ontology term by populate_graph.py from the catalog's grounding map." ;
    rdfs:range xsd:string .

Watson:groundingNote a owl:DatatypeProperty ;
    rdfs:label "grounding note" ;
    rdfs:range xsd:string .

Watson:entityType a owl:DatatypeProperty ;
    rdfs:label "entity type" ;
    rdfs:domain Watson:ProvisionalEntity ;
    rdfs:range xsd:string .

Watson:provisionalStatus a owl:DatatypeProperty ;
    rdfs:label "provisional status" ;
    rdfs:domain Watson:ProvisionalEntity ;
    rdfs:range xsd:string .

# ------------------------------------------------------------------ external alignments
# Watson:Drug owl:equivalentClass obo:CHEBI_23888 is declared above (ChEBI "drug", looked up, not typed from memory).
# The DOID and MeSH matches are per individual, not per class: each Watson:Indication gets skos:exactMatch to its
# own DOID, and each Watson:TherapeuticArea gets skos:closeMatch to its MeSH category. populate_graph.py writes them
# from layer2/catalog/alignments.json (exact label or synonym matches only). A class-level DOID/MeSH term would be
# one more ID that nobody looked up, and it would be wrong: "Indication" as a whole has no single DOID.
# exactMatch for DOID: the label or a synonym matched exactly, so the two terms mean the same disease.
# closeMatch for MeSH: a therapeutic area is a business grouping (Oncology) that overlaps a MeSH category (Neoplasms)
# but is not the same set of things, so the claim is deliberately weaker.

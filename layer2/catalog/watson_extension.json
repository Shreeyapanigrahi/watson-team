 "domains": [
  {
   "name": "pmr",
   "description": "Primary market research documents as Watson governs them. Not part of the Databricks model.",
   "tables": [
    {
     "name": "documents",
     "primary_key": "document_uri",
     "description": "One row per governed market-research document (source of truth: Layer 1 lifecycle store).",
     "columns": [
      {
       "name": "document_uri",
       "type": "STRING",
       "description": "Watson document identifier, e.g. Watson:Doc_001."
      },
      {
       "name": "title",
       "type": "STRING",
       "description": "Extracted or reviewer-set title."
      },
      {
       "name": "study_type",
       "type": "STRING",
       "description": "One of the six PMR study types."
      },
      {
       "name": "therapeutic_area",
       "type": "STRING",
       "description": "Therapeutic area from the taxonomy.",
       "foreign_key_to": "product.therapeutic_area.area_name"
      },
      {
       "name": "geography",
       "type": "STRING",
       "description": "EU, US, APAC or GLOBAL."
      },
      {
       "name": "lifecycle_state",
       "type": "STRING",
       "description": "DRAFT, UNDER_REVIEW, ACTIVE, ARCHIVED or REJECTED."
      },
      {
       "name": "sensitivity_level",
       "type": "STRING",
       "description": "PUBLIC, INTERNAL, RESTRICTED or CONFIDENTIAL.",
       "tags": [
        "classification_attribute"
       ]
      },
      {
       "name": "quality_score",
       "type": "DECIMAL(5,4)",
       "description": "Weighted quality score, 0 to 1."
      },
      {
       "name": "expiry_date",
       "type": "DATE",
       "description": "Date after which the document returns to review."
      },
      {
       "name": "ingest_timestamp",
       "type": "TIMESTAMP",
       "description": "When the document was ingested."
      },
      {
       "name": "reviewed_by",
       "type": "STRING",
       "description": "Reviewer who approved it (human in the loop)."
      }
     ]
    },
    {
     "name": "chunks",
     "primary_key": "chunk_uri",
     "description": "Sub-units of a document; the unit of retrieval and of access control.",
     "columns": [
      {
       "name": "chunk_uri",
       "type": "STRING",
       "description": "Watson chunk identifier."
      },
      {
       "name": "document_uri",
       "type": "STRING",
       "description": "Parent document.",
       "foreign_key_to": "pmr.documents.document_uri"
      },
      {
       "name": "chunk_index",
       "type": "INT",
       "description": "Position within the document."
      },
      {
       "name": "chunk_text",
       "type": "STRING",
       "description": "The text of the chunk."
      },
      {
       "name": "quality_score",
       "type": "DECIMAL(5,4)",
       "description": "Inherited from the parent document."
      },
      {
       "name": "sensitivity_level",
       "type": "STRING",
       "description": "Inherited from the parent document."
      },
      {
       "name": "faiss_id",
       "type": "BIGINT",
       "description": "Row in the vector index."
      }
     ]
    },
    {
     "name": "sentiment_assertions",
     "primary_key": "assertion_uri",
     "description": "One HCP sentiment score for a brand, in a place, at a time.",
     "columns": [
      {
       "name": "assertion_uri",
       "type": "STRING",
       "description": "Identifier of the assertion."
      },
      {
       "name": "document_uri",
       "type": "STRING",
       "description": "Source document.",
       "foreign_key_to": "pmr.documents.document_uri"
      },
      {
       "name": "brand_name",
       "type": "STRING",
       "description": "Brand the score is about.",
       "foreign_key_to": "commercial.brand.brand_name"
      },
      {
       "name": "indication_name",
       "type": "STRING",
       "description": "Indication, when the document names one.",
       "foreign_key_to": "product.indication.indication_name"
      },
      {
       "name": "country_or_region",
       "type": "STRING",
       "description": "Where the sentiment applies.",
       "foreign_key_to": "masterdata.country.country_name"
      },
      {
       "name": "sentiment_score",
       "type": "DECIMAL(3,2)",
       "description": "0 (negative) to 1 (positive)."
      },
      {
       "name": "assertion_date",
       "type": "DATE",
       "description": "When the sentiment was assessed."
      }
     ]
    },
    {
     "name": "knowledge_spaces",
     "primary_key": "space_id",
     "description": "Curated named collections of documents.",
     "columns": [
      {
       "name": "space_id",
       "type": "STRING",
       "description": "Space identifier."
      },
      {
       "name": "space_name",
       "type": "STRING",
       "description": "Display name."
      },
      {
       "name": "space_owner",
       "type": "STRING",
       "description": "Responsible user (SPOC or admin)."
      },
      {
       "name": "therapeutic_area",
       "type": "STRING",
       "description": "Area the space covers, if any.",
       "foreign_key_to": "product.therapeutic_area.area_name"
      },
      {
       "name": "membership_rule",
       "type": "STRING",
       "description": "Rule deciding which documents belong."
      }
     ]
    },
    {
     "name": "lineage_records",
     "primary_key": "lineage_uri",
     "description": "One enrichment run over one document.",
     "columns": [
      {
       "name": "lineage_uri",
       "type": "STRING",
       "description": "Identifier of the run."
      },
      {
       "name": "document_uri",
       "type": "STRING",
       "description": "Document processed.",
       "foreign_key_to": "pmr.documents.document_uri"
      },
      {
       "name": "processing_timestamp",
       "type": "TIMESTAMP",
       "description": "When the run happened."
      },
      {
       "name": "enrichment_model",
       "type": "STRING",
       "description": "Embedding model used."
      },
      {
       "name": "catalog_version",
       "type": "STRING",
       "description": "Version of this data catalog the run used."
      },
      {
       "name": "chunks_produced",
       "type": "INT",
       "description": "Chunks written by the run."
      },
      {
       "name": "triples_written",
       "type": "INT",
       "description": "Triples written by the run."
      },
      {
       "name": "reviewed_by",
       "type": "STRING",
       "description": "Human reviewer who approved the document."
      }
     ]
    }
   ]
  }
 ],
